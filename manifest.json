{
  "manifest_version": 3,
  "name": "NEW Auto Coursera 1.3",
  "version": "1.3",
  "author": "Rahil Khan",
  "version_name": "1.3 ChatGPT Web",
  "description": "Complete coursera courses in just one click. Now no need to waste your valuable time in watching those nonsense videos and attempting quiz",
  "permissions": ["storage", "activeTab", "downloads", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
      "128": "images/128.png",
      "16": "images/16.png",
      "48": "images/48.png",
      "32": "images/32.png"
   },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "run_at": "document_end",
      "matches": ["*://*.coursera.org/learn*"],
      "js": ["chatgpt-policy.js", "ai-helper.js", "content.js", "course-runner-helpers.js", "course-runner.js"]
    },
    {
      "run_at" : "document_start",
      "matches": ["*://*.coursera.org/learn*"],
      "js": ["interceptor.js"],
      "world" : "MAIN"
    },
    {
      "run_at": "document_end",
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-bridge.js"]
    }
  ],
  "host_permissions": ["*://*.coursera.org/*", "https://chatgpt.com/*", "https://llm.vcoderlog.com/*", "https://api.apiz.vn/*", "https://api.openai.com/*", "https://api.groq.com/*"]
}
